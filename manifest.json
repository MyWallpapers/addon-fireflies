{
  "runtime": "canvas-v1",
  "name": "Fireflies",
  "description": "Quelques lucioles chaudes dans l’obscurité. Trajectoires douces et lumière intermittente.",
  "version": "0.1.0",
  "entry": "dist/assets/addon.js",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    {
      "id": "background",
      "type": "color",
      "label": "Fond",
      "default": "#091713"
    },
    {
      "id": "light",
      "type": "color",
      "label": "Lumière",
      "default": "#c6d895"
    },
    {
      "id": "density",
      "type": "range",
      "label": "Lucioles",
      "default": 24,
      "min": 5,
      "max": 60,
      "step": 1
    },
    {
      "id": "speed",
      "type": "range",
      "label": "Vitesse",
      "default": 1,
      "min": 0.2,
      "max": 3,
      "step": 0.1
    },
    {
      "id": "motion",
      "type": "boolean",
      "label": "Animation",
      "default": true
    }
  ]
}
